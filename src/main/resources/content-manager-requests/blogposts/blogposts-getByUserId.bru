meta {
  name: blogposts-getByUserId
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/blogposts?userId={
      "stepType": "LENGTH_VALIDATION",
      "fieldName": "title",
      "parameters": {
        "minLength": "10",
        "maxLength": "50"
      },
      "enabled": true
   
  body: none
  auth: inherit
}

params:query {
  userId: {
        "stepType": "LENGTH_VALIDATION",
        "fieldName": "title",
        "parameters": {
          "minLength": "10",
          "maxLength": "50"
        },
        "enabled": true
     
}

settings {
  encodeUrl: true
  timeout: 0
}
