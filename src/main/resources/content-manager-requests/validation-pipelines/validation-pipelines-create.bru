meta {
  name: validation-pipelines-create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/validation-pipelines
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "428c9403-b848-4c86-a29f-c4bc17959ad7",
    "description": "Sample validation pipeline",
    "contentType": "blogpost",
    "steps": [
      {
        "stepType": "LENGTH_VALIDATION",
        "fieldName": "title",
        "parameters": {
          "minLength": "11",
          "maxLength": "50"
        },
        "enabled": true
      },
      {
        "stepType": "LENGTH_VALIDATION",
        "fieldName": "content",
        "parameters": {
          "minLength": "11",
          "maxLength": "500"
        },
        "enabled": true
      }
    ]
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
