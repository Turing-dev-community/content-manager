meta {
  name: validation-pipelines-create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/validation-pipelines
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "cfae6bd8-0dd3-4d47-9ff1-da0d07b4d83f",
    "description": "Sample validation pipeline",
    "contentType": "blogpost",
    "steps": [
      {
        "stepType": "LENGTH_VALIDATION",
        "fieldName": "title",
        "parameters": {
          "minLength": "11",
          "maxLength": "50"
        },
        "enabled": true
      },
      {
        "stepType": "LENGTH_VALIDATION",
        "fieldName": "content",
        "parameters": {
          "minLength": "11",
          "maxLength": "500"
        },
        "enabled": true
      }
    ]
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
